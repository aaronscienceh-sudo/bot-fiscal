# Copie para .env e preencha. NUNCA commitar o .env real.
# Carregue com:  set -a; source .env; set +a   (ou exporte manualmente)

# --- Telegram (obrigatório p/ alertas) ---
TELEGRAM_BOT_TOKEN=cole_seu_token_aqui
TELEGRAM_CHAT_ID=cole_seu_chat_id_aqui

# --- Ollama (opcional; padrões em config.yaml) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- E-mail / IMAP (opcional; caminho 2 do bot: "buscar no email") ---
# Gmail: crie uma "senha de app" e use no lugar da senha normal.
EMAIL_IMAP_USER=seu_email@gmail.com
EMAIL_IMAP_PASSWORD=sua_senha_de_app
